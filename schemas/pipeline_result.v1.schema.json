{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/positive-emotion-engine/pipeline_result.v1.schema.json",
  "title": "Positive Emotion Engine Phase 1 Pipeline Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["pipeline_version", "policy_seed", "session_id", "features", "state", "candidate", "safety", "final_scene", "telemetry", "replay_digest"],
  "properties": {
    "pipeline_version": {"const": "phase1-reference-v1"},
    "policy_seed": {"type": "integer", "minimum": 0},
    "session_id": {"type": "string", "minLength": 1},
    "features": {"$ref": "#/$defs/features"},
    "state": {"$ref": "#/$defs/state"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "safety": {"$ref": "#/$defs/safety"},
    "final_scene": {"$ref": "#/$defs/scene"},
    "telemetry": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/telemetry"}},
    "replay_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "features": {
      "type": "object",
      "required": ["feature_schema", "activation_proxy", "engagement_proxy", "usable_sample_count", "aggregate_confidence", "missing_features", "reason_codes"],
      "properties": {
        "feature_schema": {"const": "feature-vector-v1"},
        "activation_proxy": {"type": ["number", "null"]},
        "engagement_proxy": {"type": ["number", "null"]},
        "usable_sample_count": {"type": "integer", "minimum": 0},
        "aggregate_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "missing_features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reason_codes": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": ["state", "valence", "arousal", "confidence", "uncertainty", "evidence_quality", "model_id", "reason_codes"],
      "properties": {
        "state": {"enum": ["known", "unknown"]},
        "valence": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
        "arousal": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_quality": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "reason_codes": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["parameter", "requested_value", "previous_value", "reason", "policy_id", "seed"],
      "properties": {
        "parameter": {"type": "string", "minLength": 1},
        "requested_value": {"type": "number"},
        "previous_value": {"type": "number"},
        "reason": {"type": "string", "minLength": 1},
        "policy_id": {"const": "synthetic-reference-v1"},
        "seed": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": ["approved", "applied_value", "clamped", "decision_codes"],
      "properties": {
        "approved": {"type": "boolean"},
        "applied_value": {"type": ["number", "null"]},
        "clamped": {"type": "boolean"},
        "decision_codes": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "required": ["light_intensity", "motion_intensity", "audio_intensity", "scene_density"],
      "properties": {
        "light_intensity": {"type": "number", "minimum": 0.20, "maximum": 1.00},
        "motion_intensity": {"type": "number", "minimum": 0.00, "maximum": 0.60},
        "audio_intensity": {"type": "number", "minimum": 0.00, "maximum": 0.70},
        "scene_density": {"type": "number", "minimum": 0.10, "maximum": 0.80}
      },
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "required": ["schema_version", "event_id", "session_id", "seq", "event_type", "component_version", "parent_event_ids", "payload"],
      "properties": {
        "schema_version": {"const": "telemetry-v1"},
        "event_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "seq": {"type": "integer", "minimum": 1},
        "event_type": {"enum": ["features", "affect_state_estimate", "candidate_environment_command", "safety_decision", "scene_applied"]},
        "component_version": {"const": "phase1-reference-v1"},
        "parent_event_ids": {"type": "array", "items": {"type": "string"}},
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
