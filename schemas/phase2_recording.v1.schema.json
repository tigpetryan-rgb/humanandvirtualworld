{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase2_recording.v1.schema.json",
  "type": "object",
  "required": ["schema_version", "session_id", "data_class", "channels"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "session_id": {"type": "string", "minLength": 1},
    "data_class": {"enum": ["synthetic_recorded", "deidentified_recorded"]},
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "unit", "nominal_hz", "clock", "samples"],
        "properties": {
          "name": {"enum": ["heart_ibi_ms", "eda_us", "respiration_norm"]},
          "unit": {"type": "string"},
          "sampling_mode": {"enum": ["regular", "event"]},
          "nominal_hz": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "clock": {
            "type": "object",
            "required": ["offset_ms", "drift_ppm"],
            "properties": {
              "offset_ms": {"type": "number"},
              "drift_ppm": {"type": "number"}
            },
            "additionalProperties": false
          },
          "samples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["seq", "source_time_ms", "value"],
              "properties": {
                "seq": {"type": "integer", "minimum": 0},
                "source_time_ms": {"type": "number"},
                "value": {"type": ["number", "null"]}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"sampling_mode": {"const": "regular"}}, "required": ["sampling_mode"]},
            "then": {"properties": {"nominal_hz": {"type": "number", "exclusiveMinimum": 0}}}
          },
          {
            "if": {"not": {"required": ["sampling_mode"]}},
            "then": {"properties": {"nominal_hz": {"type": "number", "exclusiveMinimum": 0}}}
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
